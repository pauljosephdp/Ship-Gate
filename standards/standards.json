{
  "_doc": "One rule set for Ship-Gate (the merge gate) and website-audit (the live auditor). Ship-Gate owns this file; website-audit carries a generated copy (references/standards/standards.json + GENERATED.json, written by its sync script) and validate fails on a hand edit. Every entry names its primary source and the date it was checked. A change here is a Ship-Gate release.",
  "version": "1.0.0",
  "checked": "2026-11-14",
  "agents": [
    {"token": "Googlebot", "vendor": "Google", "roles": ["search"], "robots": "obeys", "rendersJs": true, "verify": "reverse DNS *.googlebot.com / crawl-*.googlebot.com", "ipList": "https://developers.google.com/static/crawling/ipranges/common-crawlers.json", "ua": "Mozilla/5.0 AppleWebKit/537.36 (KHTML, like Gecko); compatible; Googlebot/2.1; +http://www.google.com/bot.html", "source": "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers"},
