---
// PostHog in the browser, bundled from posthog-js (ship-gate.config.json → posthog.embed "npm").
// Put <PostHog /> in the base layout's <head>, so every page loads it. The bundle is a
// same-origin /_astro/ script, so CSP needs no inline-script allowance.
// posthog-js loads lazily: a dynamic import once the page has loaded and the browser is idle
// (1 s at most), so its ~95 KB stays out of the first-screen JS. On init it fires `posthog:ready`
// on document. Initialises nothing when PUBLIC_POSTHOG_KEY is unset.
---
<script>
  import { posthogOptions } from '../lib/posthog-options';

  const key = import.meta.env.PUBLIC_POSTHOG_KEY;

  async function start(key: string) {
    const { default: posthog } = await import('posthog-js');
    // Preview and local traffic stay out of production analytics.
    const tag = { environment: __DEPLOY_ENV__ };
    posthog.init(key, {
      ...posthogOptions,
      tracing_headers: [location.hostname],
      // Consent moves posthog-js between cookieless and cookie storage, which drops
      // registered properties: without this, every event after opt-in goes untagged.
      loaded: (ph) => {
        const optIn = ph.opt_in_capturing.bind(ph);
        const optOut = ph.opt_out_capturing.bind(ph);
        ph.opt_in_capturing = (...a: Parameters<typeof optIn>) => { optIn(...a); ph.register(tag); };
        ph.opt_out_capturing = () => { optOut(); ph.register(tag); };
      },
    });
    posthog.register(tag);
    window.posthog = posthog;
    document.dispatchEvent(new Event('posthog:ready'));
  }

  // <ClientRouter> re-runs scripts on navigation; initialise once.
  if (key && !window.__posthog_initialized) {
    window.__posthog_initialized = true;
    const idle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(() => void start(key), { timeout: 1000 })
        : setTimeout(() => void start(key), 1000);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }
</script>
