// The fixture's Worker. No bindings: Ship Gate runs it locally with "server": "preview".
{
  "name": "ship-gate-fixture-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/account/*", "/private/", "/signin/", "/feed.xml", "/api/*"] }
}
